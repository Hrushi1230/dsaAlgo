      "end_ms": 25020,
      "start_frame": 694,
      "end_frame": 751,
      "word_count": 3
    },
    {
      "text": "Medium.",
      "start_ms": 25960,
      "end_ms": 26480,
      "start_frame": 779,
      "end_frame": 794,
      "word_count": 1
    },
    {
      "text": "This question looks simple at first.",
      "start_ms": 27340,
      "end_ms": 29720,
      "start_frame": 820,
      "end_frame": 892,
      "word_count": 6
    },
    {
      "text": "But one small detail changes the whole problem.",
