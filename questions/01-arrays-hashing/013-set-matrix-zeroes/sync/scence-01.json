      "end_ms": 19760,
      "start_frame": 493,
      "end_frame": 593,
      "word_count": 7
    },
    {
      "text": "Set matrix zeros.",
      "start_ms": 20500,
      "end_ms": 22320,
      "start_frame": 615,
      "end_frame": 670,
      "word_count": 3
    },
    {
      "text": "Lead code 73.",
