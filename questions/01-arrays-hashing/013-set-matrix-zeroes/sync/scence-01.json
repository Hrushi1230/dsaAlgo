  "sentences": [
    {
      "text": "Welcome back to Code with Animation.",
      "start_ms": 0,
      "end_ms": 2240,
      "start_frame": 0,
      "end_frame": 67,
      "word_count": 6
    },
    {
      "text": "We are continuing our arrays and hashing roadmap.",
      "start_ms": 2740,
      "end_ms": 5840,
      "start_frame": 82,
      "end_frame": 175,
      "word_count": 8
    },
    {
      "text": "Question 12.",
      "start_ms": 6540,
      "end_ms": 7720,
      "start_frame": 196,
      "end_frame": 232,
      "word_count": 2
    },
    {
      "text": "Next permutation is complete.",
      "start_ms": 8300,
      "end_ms": 10800,
      "start_frame": 249,
      "end_frame": 324,
      "word_count": 4
    },
    {
      "text": "Our global progress is now 12 out of 227.",
      "start_ms": 11660,
      "end_ms": 16020,
      "start_frame": 350,
      "end_frame": 481,
      "word_count": 9
    },
    {
      "text": "And the next problem is question 13.",
