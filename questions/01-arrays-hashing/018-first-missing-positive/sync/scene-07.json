  "sentences": [
    {
      "text": "Create an empty scene set.",
      "start_ms": 0,
      "end_ms": 2300,
      "start_frame": 0,
      "end_frame": 69,
      "word_count": 5
    },
    {
      "text": "To remember, membership.",
      "start_ms": 3500,
      "end_ms": 5080,
      "start_frame": 105,
      "end_frame": 152,
      "word_count": 3
    },
    {
      "text": "Loop through the input and add every value.",
      "start_ms": 5760,
      "end_ms": 8960,
      "start_frame": 173,
      "end_frame": 269,
      "word_count": 8
    },
    {
      "text": "Duplicates are handled automatically by the set.",
      "start_ms": 9580,
      "end_ms": 12260,
      "start_frame": 287,
      "end_frame": 368,
      "word_count": 7
    },
    {
      "text": "Start candidate at 1.",
      "start_ms": 12860,
      "end_ms": 14460,
      "start_frame": 386,
      "end_frame": 434,
      "word_count": 4
    },
    {
      "text": "Because we still need the smallest positive.",
      "start_ms": 15200,
      "end_ms": 17660,
      "start_frame": 456,
      "end_frame": 530,
      "word_count": 7
    },
    {
      "text": "While the candidate is in scene, increase it by 1.",
      "start_ms": 18320,
      "end_ms": 21500,
      "start_frame": 550,
      "end_frame": 645,
      "word_count": 10
    },
    {
      "text": "Each successful lookup rules out that number.",
      "start_ms": 22160,
      "end_ms": 25500,
      "start_frame": 665,
      "end_frame": 765,
      "word_count": 7
    },
    {
      "text": "The first failed lookup ends the loop.",
      "start_ms": 26420,
      "end_ms": 29040,
      "start_frame": 793,
      "end_frame": 871,
      "word_count": 7
    },
    {
      "text": "So return that candidate.",
      "start_ms": 29540,
      "end_ms": 31360,
      "start_frame": 886,
      "end_frame": 941,
      "word_count": 4
    },
    {
      "text": "This removes the repeated array search.",
      "start_ms": 32360,
      "end_ms": 35020,
      "start_frame": 971,
      "end_frame": 1051,
      "word_count": 6
    },
    {
      "text": "But what is the cost of remembering all those values?",
      "start_ms": 36120,
      "end_ms": 39760,
      "start_frame": 1084,
      "end_frame": 1193,
      "word_count": 10
    }
  ],
