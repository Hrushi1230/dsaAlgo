  "sentences": [
    {
      "text": "Start candidate at 1, because our answer must be positive, and we need the smallest.",
      "start_ms": 0,
      "end_ms": 6680,
      "start_frame": 0,
      "end_frame": 200,
      "word_count": 15
    },
    {
      "text": "The outer loop keeps trying candidates, one after another.",
      "start_ms": 7360,
      "end_ms": 11720,
      "start_frame": 221,
      "end_frame": 352,
      "word_count": 9
    },
    {
      "text": "For each new candidate, reset found to false.",
      "start_ms": 12360,
      "end_ms": 16040,
      "start_frame": 371,
      "end_frame": 481,
      "word_count": 8
    },
    {
      "text": "An earlier candidate's result must not carry over.",
      "start_ms": 17040,
      "end_ms": 20420,
      "start_frame": 511,
      "end_frame": 613,
      "word_count": 8
    },
    {
      "text": "The inner loop searches the array for that candidate.",
      "start_ms": 20900,
      "end_ms": 24180,
      "start_frame": 627,
      "end_frame": 725,
      "word_count": 9
    },
    {
      "text": "If a value matches, set found to true and break.",
      "start_ms": 24560,
      "end_ms": 28660,
      "start_frame": 737,
      "end_frame": 860,
      "word_count": 10
    },
    {
      "text": "More checks cannot change that result.",
      "start_ms": 29340,
      "end_ms": 31800,
      "start_frame": 880,
      "end_frame": 954,
      "word_count": 6
    },
    {
      "text": "After the search, if found is still false, return the candidate.",
      "start_ms": 32600,
      "end_ms": 37020,
      "start_frame": 978,
      "end_frame": 1111,
      "word_count": 11
    },
    {
      "text": "That's the first number missing.",
      "start_ms": 38100,
      "end_ms": 40180,
      "start_frame": 1143,
      "end_frame": 1205,
      "word_count": 5
    },
    {
      "text": "Otherwise, increase the candidate by 1 and repeat.",
      "start_ms": 41040,
      "end_ms": 45260,
      "start_frame": 1231,
      "end_frame": 1358,
      "word_count": 8
    },
    {
      "text": "Correct!",
      "start_ms": 46260,
      "end_ms": 46620,
      "start_frame": 1388,
      "end_frame": 1399,
      "word_count": 1
    },
    {
      "text": "But the repeated scans cost time.",
      "start_ms": 47220,
      "end_ms": 49620,
      "start_frame": 1417,
      "end_frame": 1489,
      "word_count": 6
    }
  ],
