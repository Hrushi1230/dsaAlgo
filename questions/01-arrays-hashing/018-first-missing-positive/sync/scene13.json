  "sentences": [
    {
      "text": "Brute force repeats searches.",
      "start_ms": 0,
      "end_ms": 1980,
      "start_frame": 0,
      "end_frame": 59,
      "word_count": 4
    },
    {
      "text": "Hash set fixes time but uses extra memory.",
      "start_ms": 2540,
      "end_ms": 5420,
      "start_frame": 76,
      "end_frame": 163,
      "word_count": 8
    },
    {
      "text": "In -place placement uses the array itself.",
      "start_ms": 5860,
      "end_ms": 8540,
      "start_frame": 176,
      "end_frame": 256,
      "word_count": 7
    },
    {
      "text": "Value x belongs at index x minus 1.",
      "start_ms": 9140,
      "end_ms": 12320,
      "start_frame": 274,
      "end_frame": 370,
      "word_count": 8
    },
    {
      "text": "The first mismatch gives the answer.",
      "start_ms": 12860,
      "end_ms": 14980,
      "start_frame": 386,
      "end_frame": 449,
      "word_count": 6
    },
    {
      "text": "Question 18, complete.",
