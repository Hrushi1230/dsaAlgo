  "sentences": [
    {
      "text": "First handle the empty array.",
      "start_ms": 0,
      "end_ms": 1740,
      "start_frame": 0,
      "end_frame": 52,
      "word_count": 5
    },
    {
      "text": "If nums is empty, there is no sequence.",
      "start_ms": 2140,
      "end_ms": 4660,
      "start_frame": 64,
      "end_frame": 140,
      "word_count": 8
    },
    {
      "text": "So return zero.",
      "start_ms": 5380,
      "end_ms": 6620,
      "start_frame": 161,
      "end_frame": 199,
      "word_count": 3
    },
    {
      "text": "Then sort nums, now both longest and current, start at 1.",
      "start_ms": 7520,
      "end_ms": 11540,
      "start_frame": 226,
      "end_frame": 346,
      "word_count": 11
    },
    {
      "text": "We begin from index 1.",
      "start_ms": 12280,
      "end_ms": 13940,
      "start_frame": 368,
      "end_frame": 418,
      "word_count": 5
    },
    {
      "text": "Because every value will be compared with the value just before it.",
      "start_ms": 14440,
      "end_ms": 18700,
      "start_frame": 433,
      "end_frame": 561,
      "word_count": 12
    },
    {
      "text": "First condition, if both values are equal, this is a duplicate.",
      "start_ms": 19160,
      "end_ms": 23720,
      "start_frame": 575,
      "end_frame": 712,
      "word_count": 11
    },
    {
      "text": "So just continue.",
      "start_ms": 24140,
      "end_ms": 25140,
      "start_frame": 724,
      "end_frame": 754,
      "word_count": 3
    },
    {
      "text": "Do not increase the sequence.",
      "start_ms": 25700,
      "end_ms": 27240,
      "start_frame": 771,
      "end_frame": 817,
      "word_count": 5
    },
    {
      "text": "Do not reset it.",
      "start_ms": 27700,
      "end_ms": 29040,
      "start_frame": 831,
      "end_frame": 871,
      "word_count": 4
    },
    {
      "text": "Just ignore the duplicate.",
      "start_ms": 29040,
      "end_ms": 30720,
      "start_frame": 871,
      "end_frame": 922,
      "word_count": 4
    },
    {
      "text": "Next, if the current value is previous value plus 1, we have a consecutive step.",
      "start_ms": 31500,
      "end_ms": 37520,
      "start_frame": 945,
      "end_frame": 1126,
      "word_count": 15
    },
    {
      "text": "Increase current.",
      "start_ms": 37900,
      "end_ms": 38940,
      "start_frame": 1137,
      "end_frame": 1168,
      "word_count": 2
    },
    {
      "text": "Otherwise, there is a gap.",
      "start_ms": 39400,
      "end_ms": 41660,
      "start_frame": 1182,
      "end_frame": 1250,
      "word_count": 5
    },
    {
      "text": "So a new sequence starts here.",
      "start_ms": 42340,
      "end_ms": 44440,
      "start_frame": 1270,
      "end_frame": 1333,
      "word_count": 6
    },
    {
      "text": "And current goes back to 1.",
      "start_ms": 44860,
      "end_ms": 46540,
      "start_frame": 1346,
      "end_frame": 1396,
      "word_count": 6
    },
    {
      "text": "After each real step, update longest.",
      "start_ms": 47040,
      "end_ms": 49940,
      "start_frame": 1411,
      "end_frame": 1498,
      "word_count": 6
    },
    {
      "text": "At the end, return longest.",
      "start_ms": 50480,
      "end_ms": 52580,
      "start_frame": 1514,
      "end_frame": 1577,
      "word_count": 5
    },
    {
      "text": "Simple scan.",
      "start_ms": 53500,
      "end_ms": 54340,
      "start_frame": 1605,
      "end_frame": 1630,
      "word_count": 2
    },
    {
      "text": "Clean code.",
      "start_ms": 54780,
      "end_ms": 55520,
      "start_frame": 1643,
      "end_frame": 1666,
      "word_count": 2
    },
    {
      "text": "And much better than repeated list searching.",
      "start_ms": 56020,
      "end_ms": 58500,
      "start_frame": 1681,
      "end_frame": 1755,
      "word_count": 7
    }
  ],
