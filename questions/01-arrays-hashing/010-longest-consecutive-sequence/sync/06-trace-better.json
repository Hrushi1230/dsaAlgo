  "sentences": [
    {
      "text": "Same input.",
      "start_ms": 0,
      "end_ms": 780,
      "start_frame": 0,
      "end_frame": 23,
      "word_count": 2
    },
    {
      "text": "8, 1, 6, 3, 2, 2, 4, 10, 9, 11, minus 1, 0.",
      "start_ms": 1280,
      "end_ms": 7460,
      "start_frame": 38,
      "end_frame": 224,
      "word_count": 13
    },
    {
      "text": "After sorting, minus 1, 0, 1, 2, 2, 3, 4, 6, 8, 9, 10, 11.",
      "start_ms": 8060,
      "end_ms": 16960,
      "start_frame": 242,
      "end_frame": 509,
      "word_count": 15
    },
    {
      "text": "Start with minus 1.",
      "start_ms": 17560,
      "end_ms": 18580,
      "start_frame": 527,
      "end_frame": 557,
      "word_count": 4
    },
    {
      "text": "Current length is 1.",
      "start_ms": 18760,
      "end_ms": 19860,
      "start_frame": 563,
      "end_frame": 596,
      "word_count": 4
    },
    {
      "text": "Move to 0.",
      "start_ms": 20080,
      "end_ms": 20880,
      "start_frame": 602,
      "end_frame": 626,
      "word_count": 3
    },
    {
      "text": "0 is exactly minus 1 plus 1.",
      "start_ms": 21360,
      "end_ms": 24320,
      "start_frame": 641,
      "end_frame": 730,
      "word_count": 7
    },
    {
      "text": "Length 2.",
      "start_ms": 24540,
      "end_ms": 25180,
      "start_frame": 736,
      "end_frame": 755,
      "word_count": 2
    },
    {
      "text": "Move to 1.",
      "start_ms": 25260,
      "end_ms": 26080,
      "start_frame": 758,
      "end_frame": 782,
      "word_count": 3
    },
    {
      "text": "1 is 0 plus 1.",
      "start_ms": 26080,
      "end_ms": 28520,
      "start_frame": 782,
      "end_frame": 856,
      "word_count": 5
    },
    {
      "text": "Length 3.",
      "start_ms": 28760,
      "end_ms": 29460,
      "start_frame": 863,
      "end_frame": 884,
      "word_count": 2
    },
    {
      "text": "Move to 2.",
      "start_ms": 29640,
      "end_ms": 30380,
      "start_frame": 889,
      "end_frame": 911,
      "word_count": 3
    },
    {
      "text": "2 is 1 plus 1.",
      "start_ms": 30840,
      "end_ms": 32500,
      "start_frame": 925,
      "end_frame": 975,
      "word_count": 5
    },
    {
      "text": "Length 4.",
      "start_ms": 33020,
      "end_ms": 33700,
      "start_frame": 991,
      "end_frame": 1011,
      "word_count": 2
    },
    {
      "text": "Now the next value is 2, again.",
      "start_ms": 34040,
      "end_ms": 36140,
      "start_frame": 1021,
      "end_frame": 1084,
      "word_count": 7
    },
    {
      "text": "This is a duplicate.",
      "start_ms": 36840,
      "end_ms": 37740,
      "start_frame": 1105,
      "end_frame": 1132,
      "word_count": 4
    },
    {
      "text": "It does not increase the sequence.",
      "start_ms": 38240,
      "end_ms": 40020,
      "start_frame": 1147,
      "end_frame": 1201,
      "word_count": 6
    },
    {
      "text": "And it does not break the sequence, so ignore it.",
      "start_ms": 40480,
      "end_ms": 43160,
      "start_frame": 1214,
      "end_frame": 1295,
      "word_count": 10
    },
    {
      "text": "Current length stays 4.",
      "start_ms": 43960,
      "end_ms": 45380,
      "start_frame": 1319,
      "end_frame": 1361,
      "word_count": 4
    },
    {
      "text": "Move to 3.",
      "start_ms": 45680,
      "end_ms": 46580,
      "start_frame": 1370,
      "end_frame": 1397,
      "word_count": 3
    },
    {
      "text": "3 is 2 plus 1.",
      "start_ms": 46820,
      "end_ms": 48560,
      "start_frame": 1405,
      "end_frame": 1457,
      "word_count": 5
    },
    {
      "text": "Length 5.",
      "start_ms": 49100,
      "end_ms": 49920,
      "start_frame": 1473,
      "end_frame": 1498,
      "word_count": 2
    },
    {
      "text": "Move to 4.",
      "start_ms": 50220,
      "end_ms": 51180,
      "start_frame": 1507,
      "end_frame": 1535,
      "word_count": 3
    },
    {
      "text": "4 is 3 plus 1.",
      "start_ms": 51440,
      "end_ms": 53320,
      "start_frame": 1543,
      "end_frame": 1600,
      "word_count": 5
    },
    {
      "text": "Length 6.",
      "start_ms": 53320,
      "end_ms": 54560,
      "start_frame": 1600,
      "end_frame": 1637,
      "word_count": 2
    },
    {
      "text": "Best becomes 6.",
      "start_ms": 54740,
      "end_ms": 56120,
      "start_frame": 1642,
      "end_frame": 1684,
      "word_count": 3
    },
    {
      "text": "Now 4 to 6.",
      "start_ms": 56620,
      "end_ms": 57680,
      "start_frame": 1699,
      "end_frame": 1730,
      "word_count": 4
    },
    {
      "text": "5 is missing.",
      "start_ms": 58100,
      "end_ms": 58900,
      "start_frame": 1743,
      "end_frame": 1767,
      "word_count": 3
    },
    {
      "text": "So the sequence breaks.",
      "start_ms": 59680,
      "end_ms": 60800,
      "start_frame": 1790,
      "end_frame": 1824,
      "word_count": 4
    },
    {
      "text": "Reset current length to 1 for 6.",
      "start_ms": 61300,
      "end_ms": 63280,
      "start_frame": 1839,
      "end_frame": 1898,
      "word_count": 7
    },
    {
      "text": "Next, 6 to 8.",
      "start_ms": 63540,
      "end_ms": 65140,
      "start_frame": 1906,
      "end_frame": 1954,
      "word_count": 4
    },
    {
      "text": "7 is missing.",
      "start_ms": 65560,
      "end_ms": 66440,
      "start_frame": 1967,
      "end_frame": 1993,
      "word_count": 3
    },
    {
      "text": "Break again.",
      "start_ms": 67020,
      "end_ms": 67520,
      "start_frame": 2011,
      "end_frame": 2026,
      "word_count": 2
    },
    {
      "text": "Current length is 1 for 8.",
      "start_ms": 68480,
      "end_ms": 70260,
      "start_frame": 2054,
      "end_frame": 2108,
      "word_count": 6
    },
    {
      "text": "Now 8 to 9, consecutive.",
      "start_ms": 70660,
      "end_ms": 72500,
      "start_frame": 2120,
      "end_frame": 2175,
      "word_count": 5
    },
    {
      "text": "Length 2.",
      "start_ms": 73120,
      "end_ms": 73820,
      "start_frame": 2194,
      "end_frame": 2215,
      "word_count": 2
    },
    {
      "text": "9 to 10, consecutive.",
      "start_ms": 74140,
      "end_ms": 75800,
      "start_frame": 2224,
      "end_frame": 2274,
      "word_count": 4
    },
    {
      "text": "Length 3.",
      "start_ms": 76440,
      "end_ms": 77140,
      "start_frame": 2293,
      "end_frame": 2314,
      "word_count": 2
    },
    {
      "text": "10 to 11, consecutive.",
      "start_ms": 77420,
      "end_ms": 79080,
      "start_frame": 2323,
      "end_frame": 2372,
      "word_count": 4
    },
    {
      "text": "Length 4.",
      "start_ms": 79520,
      "end_ms": 80220,
      "start_frame": 2386,
      "end_frame": 2407,
      "word_count": 2
    },
    {
      "text": "Best is still 6.",
      "start_ms": 80480,
      "end_ms": 81740,
      "start_frame": 2414,
      "end_frame": 2452,
      "word_count": 4
    },
    {
      "text": "Done.",
      "start_ms": 81800,
      "end_ms": 82100,
      "start_frame": 2454,
      "end_frame": 2463,
      "word_count": 1
    },
    {
      "text": "So while scanning the sorted array, plus 1 means extend.",
      "start_ms": 82100,
      "end_ms": 86620,
      "start_frame": 2463,
      "end_frame": 2599,
      "word_count": 10
    },
    {
      "text": "Same value means duplicate.",
      "start_ms": 87200,
      "end_ms": 88960,
      "start_frame": 2616,
      "end_frame": 2669,
      "word_count": 4
    },
    {
      "text": "Ignore it.",
      "start_ms": 89440,
      "end_ms": 90070,
      "start_frame": 2683,
      "end_frame": 2702,
      "word_count": 2
    },
    {
      "text": "Anything else means gap.",
      "start_ms": 90860,
      "end_ms": 92160,
      "start_frame": 2726,
      "end_frame": 2765,
      "word_count": 4
    },
    {
      "text": "Reset.",
      "start_ms": 93060,
      "end_ms": 93820,
      "start_frame": 2792,
      "end_frame": 2815,
      "word_count": 1
    },
    {
      "text": "Now let's write exactly this scan in code.",
      "start_ms": 94480,
