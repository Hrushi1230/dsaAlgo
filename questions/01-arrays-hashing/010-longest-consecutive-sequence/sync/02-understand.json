  "sentences": [
    {
      "text": "We are given an unsorted array of integers.",
      "start_ms": 0,
      "end_ms": 3500,
      "start_frame": 0,
      "end_frame": 105,
      "word_count": 8
    },
    {
      "text": "We need only one thing, the length of the longest consecutive sequence.",
      "start_ms": 3960,
      "end_ms": 9520,
      "start_frame": 119,
      "end_frame": 286,
      "word_count": 12
    },
    {
      "text": "Consecutive means the values continue by 1.",
      "start_ms": 10120,
      "end_ms": 13620,
      "start_frame": 304,
      "end_frame": 409,
      "word_count": 7
    },
    {
      "text": "1, 2, 3, 4.",
      "start_ms": 14160,
      "end_ms": 17460,
      "start_frame": 425,
      "end_frame": 524,
      "word_count": 4
    },
    {
      "text": "They do not need to sit next to each other inside the input.",
      "start_ms": 18040,
      "end_ms": 21380,
      "start_frame": 541,
      "end_frame": 641,
      "word_count": 13
    },
    {
      "text": "Now this is our main example.",
      "start_ms": 21840,
      "end_ms": 23640,
      "start_frame": 655,
      "end_frame": 709,
      "word_count": 6
    },
    {
      "text": "8, 1, 6, 3, 2, 2, 4, 10, 9, 11, minus 1, 0.",
      "start_ms": 24260,
      "end_ms": 31460,
      "start_frame": 728,
      "end_frame": 944,
      "word_count": 13
    },
    {
      "text": "It has a duplicate, a negative value, and the numbers are completely unsorted.",
      "start_ms": 32480,
      "end_ms": 38040,
      "start_frame": 974,
      "end_frame": 1141,
      "word_count": 13
    },
    {
      "text": "For this input, the answer is 6.",
      "start_ms": 38740,
      "end_ms": 41200,
      "start_frame": 1162,
      "end_frame": 1236,
      "word_count": 7
    },
    {
      "text": "Why 6?",
      "start_ms": 41900,
      "end_ms": 42760,
      "start_frame": 1257,
      "end_frame": 1283,
      "word_count": 2
    },
    {
      "text": "We will prove it while tracing the approaches.",
      "start_ms": 43100,
      "end_ms": 46660,
      "start_frame": 1293,
      "end_frame": 1400,
      "word_count": 8
    },
    {
      "text": "First, let's try the most direct method.",
      "start_ms": 47320,
      "end_ms": 50300,
      "start_frame": 1420,
      "end_frame": 1509,
      "word_count": 7
    }
  ],
