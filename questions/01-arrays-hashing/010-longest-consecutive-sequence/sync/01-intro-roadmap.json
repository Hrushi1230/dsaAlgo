  "sentences": [
    {
      "text": "Welcome back.",
      "start_ms": 0,
      "end_ms": 920,
      "start_frame": 0,
      "end_frame": 28,
      "word_count": 2
    },
    {
      "text": "We are continuing our complete DSA roadmap of 227 problems, pattern by pattern.",
      "start_ms": 1780,
      "end_ms": 10200,
      "start_frame": 53,
      "end_frame": 306,
      "word_count": 13
    },
    {
      "text": "Right now, we are inside arrays and hashing.",
      "start_ms": 11040,
      "end_ms": 14360,
      "start_frame": 331,
      "end_frame": 431,
      "word_count": 8
    },
    {
      "text": "Nine questions are complete.",
      "start_ms": 15060,
      "end_ms": 16800,
      "start_frame": 452,
      "end_frame": 504,
      "word_count": 4
    },
    {
      "text": "In the previous question, we finished valid Sudoku.",
      "start_ms": 17400,
      "end_ms": 20780,
      "start_frame": 522,
      "end_frame": 623,
      "word_count": 8
    },
    {
      "text": "Now, question number 10, longest consecutive sequence.",
      "start_ms": 21200,
      "end_ms": 26180,
      "start_frame": 636,
      "end_frame": 785,
      "word_count": 7
    },
    {
      "text": "Lead code 128, medium.",
      "start_ms": 26620,
      "end_ms": 29340,
      "start_frame": 799,
      "end_frame": 880,
      "word_count": 4
    },
    {
      "text": "The input is unsorted, but we still need to find the longest run of consecutive values.",
      "start_ms": 29340,
      "end_ms": 36640,
      "start_frame": 880,
      "end_frame": 1099,
      "word_count": 16
    },
    {
      "text": "And the target is linear time.",
      "start_ms": 37220,
      "end_ms": 39140,
      "start_frame": 1117,
      "end_frame": 1174,
      "word_count": 6
    },
    {
      "text": "Before code, first understand the question.",
      "start_ms": 39560,
      "end_ms": 43020,
      "start_frame": 1187,
      "end_frame": 1291,
      "word_count": 6
    }
  ],
