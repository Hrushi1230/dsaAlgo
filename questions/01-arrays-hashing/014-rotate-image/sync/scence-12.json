  "sentences": [
    {
      "text": "Let's compare.",
      "start_ms": 0,
      "end_ms": 780,
      "start_frame": 0,
      "end_frame": 23,
      "word_count": 2
    },
    {
      "text": "The three methods, one final time.",
      "start_ms": 1320,
      "end_ms": 3680,
      "start_frame": 40,
      "end_frame": 110,
      "word_count": 6
    },
    {
      "text": "Method one uses another n by n matrix time.",
      "start_ms": 4080,
      "end_ms": 8240,
      "start_frame": 122,
      "end_frame": 247,
      "word_count": 9
    },
    {
      "text": "O of n squared, extra space, O of n squared.",
      "start_ms": 8920,
      "end_ms": 12720,
      "start_frame": 268,
      "end_frame": 382,
      "word_count": 10
    },
    {
      "text": "Method two rotates four connected values directly inside the matrix time.",
      "start_ms": 13080,
      "end_ms": 18700,
      "start_frame": 392,
      "end_frame": 561,
      "word_count": 11
    },
    {
      "text": "O of n squared, extra space, O of one.",
      "start_ms": 19380,
      "end_ms": 23620,
      "start_frame": 581,
      "end_frame": 709,
      "word_count": 9
    },
    {
      "text": "Method three transposes, then reverses every row time.",
      "start_ms": 24160,
      "end_ms": 29860,
      "start_frame": 725,
      "end_frame": 896,
      "word_count": 8
    },
    {
      "text": "O of n squared, extra space, O of one.",
      "start_ms": 30630,
      "end_ms": 34880,
      "start_frame": 919,
      "end_frame": 1046,
      "word_count": 9
    },
    {
      "text": "So both in -place methods have the required constant extra space.",
      "start_ms": 35500,
      "end_ms": 40640,
      "start_frame": 1065,
      "end_frame": 1219,
      "word_count": 11
    }
  ],
