  "sentences": [
    {
      "text": "First, store n, the size of the matrix, then create a new n by n result matrix.",
      "start_ms": 0,
      "end_ms": 8140,
      "start_frame": 0,
      "end_frame": 244,
      "word_count": 17
    },
    {
      "text": "Now loop through every source row r and every source column c.",
      "start_ms": 8680,
      "end_ms": 13420,
      "start_frame": 260,
      "end_frame": 403,
      "word_count": 12
    },
    {
      "text": "For the current value, matrix c, write it into results in minus 1 minus r.",
      "start_ms": 13820,
