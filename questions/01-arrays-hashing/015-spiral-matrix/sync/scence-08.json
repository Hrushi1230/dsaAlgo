      "start_frame": 91,
      "end_frame": 147,
      "word_count": 6
    },
    {
      "text": "Bottom is m minus 1.",
      "start_ms": 5160,
      "end_ms": 6940,
      "start_frame": 155,
      "end_frame": 208,
      "word_count": 5
    },
    {
      "text": "And right is n minus 1.",
      "start_ms": 7240,
      "end_ms": 9400,
      "start_frame": 217,
      "end_frame": 282,
      "word_count": 6
    },
    {
      "text": "The main loop continues only while the active rectangle is valid.",
