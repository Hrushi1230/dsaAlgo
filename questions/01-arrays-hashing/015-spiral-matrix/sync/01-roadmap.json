  "sentences": [
    {
      "text": "Welcome back to Code with Animation.",
      "start_ms": 0,
      "end_ms": 2220,
      "start_frame": 0,
      "end_frame": 67,
      "word_count": 6
    },
    {
      "text": "Question 14, rotate image is complete.",
