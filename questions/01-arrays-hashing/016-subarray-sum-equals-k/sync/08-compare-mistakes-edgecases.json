  "sentences": [
    {
      "text": "Quick comparison.",
      "start_ms": 0,
      "end_ms": 1260,
      "start_frame": 0,
      "end_frame": 38,
      "word_count": 2
    },
    {
      "text": "Method 1, running sum enumeration.",
      "start_ms": 1760,
      "end_ms": 4440,
      "start_frame": 53,
      "end_frame": 133,
      "word_count": 5
    },
    {
      "text": "Time, O of n squared, auxiliary space, O of 1.",
      "start_ms": 4960,
      "end_ms": 9660,
      "start_frame": 149,
      "end_frame": 290,
      "word_count": 10
    },
    {
      "text": "Method 2, prefix sum plus frequency hash map.",
      "start_ms": 10160,
      "end_ms": 13980,
      "start_frame": 305,
      "end_frame": 419,
      "word_count": 8
    },
    {
      "text": "Expected time, O of n auxiliary space.",
      "start_ms": 14480,
      "end_ms": 17560,
      "start_frame": 434,
      "end_frame": 527,
      "word_count": 7
    },
    {
      "text": "O of n key mistakes.",
      "start_ms": 18180,
      "end_ms": 19720,
      "start_frame": 545,
      "end_frame": 592,
      "word_count": 5
    },
    {
      "text": "Normal sliding window is not reliable when negative numbers are allowed.",
      "start_ms": 20340,
      "end_ms": 24620,
      "start_frame": 610,
      "end_frame": 739,
      "word_count": 11
    },
    {
      "text": "Store prefix frequency, not only existence.",
      "start_ms": 25480,
      "end_ms": 28580,
      "start_frame": 764,
      "end_frame": 857,
      "word_count": 6
    },
    {
      "text": "Start with 0 maps to 1.",
      "start_ms": 29120,
      "end_ms": 32120,
      "start_frame": 874,
      "end_frame": 964,
      "word_count": 6
    },
    {
      "text": "Query before inserting the current prefix.",
      "start_ms": 32700,
      "end_ms": 34960,
      "start_frame": 981,
      "end_frame": 1049,
      "word_count": 6
    },
    {
      "text": "And remember, array index and prefix position are different.",
      "start_ms": 36040,
      "end_ms": 40320,
      "start_frame": 1081,
      "end_frame": 1210,
      "word_count": 9
    },
    {
      "text": "Important edge cases.",
      "start_ms": 40940,
      "end_ms": 42440,
      "start_frame": 1228,
      "end_frame": 1273,
      "word_count": 3
    },
    {
      "text": "3, target 3, answer 1, 0, target 0.",
      "start_ms": 43000,
      "end_ms": 47960,
      "start_frame": 1290,
      "end_frame": 1439,
      "word_count": 8
    },
    {
      "text": "Answer 1, 0, 0, 0, target 0.",
      "start_ms": 48780,
      "end_ms": 53600,
      "start_frame": 1463,
      "end_frame": 1608,
      "word_count": 7
    },
    {
      "text": "Answer 6.",
      "start_ms": 54060,
      "end_ms": 55500,
      "start_frame": 1622,
      "end_frame": 1665,
      "word_count": 2
    },
    {
      "text": "The key rule is, answer plus equals frequency of needed prefix.",
      "start_ms": 55500,
      "end_ms": 60520,
      "start_frame": 1665,
      "end_frame": 1816,
      "word_count": 11
    }
  ],
