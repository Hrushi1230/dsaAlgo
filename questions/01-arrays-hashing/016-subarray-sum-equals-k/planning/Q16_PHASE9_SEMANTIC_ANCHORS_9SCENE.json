    "07": [
      {
        "id": "S07_A001",
        "phrase": "Start with the frequency map."
      },
      {
        "id": "S07_A002",
        "phrase": "Put zero with frequency one."
      },
      {
        "id": "S07_A003",
        "phrase": "Then set prefix to zero."
      },
      {
        "id": "S07_A004",
        "phrase": "And answer to zero."
      },
      {
        "id": "S07_A005",
        "phrase": "Now move through the array one value at a time."
      },
      {
        "id": "S07_A006",
        "phrase": "Add the current value to the prefix."
      },
      {
        "id": "S07_A007",
        "phrase": "Then calculate:"
      },
      {
        "id": "S07_A008",
        "phrase": "needed equals prefix minus `k`."
      },
      {
        "id": "S07_A009",
        "phrase": "Now query the frequency map."
      },
      {
        "id": "S07_A010",
        "phrase": "How many earlier prefixes equal `needed`?"
      },
      {
        "id": "S07_A011",
        "phrase": "Add that frequency to the answer."
      },
      {
        "id": "S07_A012",
        "phrase": "Only after the lookup …"
