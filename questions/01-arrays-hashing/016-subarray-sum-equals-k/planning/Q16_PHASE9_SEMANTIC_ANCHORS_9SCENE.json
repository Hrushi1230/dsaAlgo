    "05": [
      {
        "id": "S05_A001",
        "phrase": "We do not want to rebuild the same overlapping sums again and again."
      },
      {
        "id": "S05_A002",
        "phrase": "Suppose the current prefix sum is `S`."
      },
      {
        "id": "S05_A003",
        "phrase": "For a subarray sum to be exactly `k` ..."
      },
      {
        "id": "S05_A004",
        "phrase": "we need an earlier prefix equal to ..."
      },
      {
        "id": "S05_A005",
        "phrase": "`S minus k`."
      },
      {
        "id": "S05_A006",
        "phrase": "So at every position ..."
      },
      {
        "id": "S05_A007",
        "phrase": "we only need to look for ..."
      },
      {
        "id": "S05_A008",
        "phrase": "`current prefix minus k`."
      },
      {
        "id": "S05_A009",
        "phrase": "But the same prefix value can appear more than once."
      },
      {
        "id": "S05_A010",
        "phrase": "So we need frequency ..."
      },
      {
        "id": "S05_A011",
        "phrase": "not just existence."
      },
      {
        "id": "S05_A012",
        "phrase": "Our HashMap stores:"
      },
      {
        "id": "S05_A013",
        "phrase": "`prefix sum ... to frequency`."
      },
      {
        "id": "S05_A014",
        "phrase": "And initially ..."
      },
      {
        "id": "S05_A015",
        "phrase": "`zero maps to one`."
      },
      {
        "id": "S05_A016",
        "phrase": "Because before reading the array ..."
      },
      {
        "id": "S05_A017",
        "phrase": "there is already one prefix position with sum zero."
      },
      {
        "id": "S05_A018",
        "phrase": "One more important rule."
      },
      {
        "id": "S05_A019",
        "phrase": "The map should contain only earlier prefix positions."
      },
      {
        "id": "S05_A020",
        "phrase": "So first ..."
      },
      {
        "id": "S05_A021",
        "phrase": "update the current prefix."
      },
      {
        "id": "S05_A022",
        "phrase": "Then compute ..."
      },
      {
        "id": "S05_A023",
        "phrase": "`needed = prefix minus k`."
      },
      {
        "id": "S05_A024",
        "phrase": "Look up the frequency of `needed`."
      },
      {
        "id": "S05_A025",
        "phrase": "Add that frequency to the answer."
      },
      {
        "id": "S05_A026",
        "phrase": "And only after that ..."
      },
      {
        "id": "S05_A027",
        "phrase": "store the current prefix."
      },
      {
        "id": "S05_A028",
        "phrase": "So the order is:"
      },
      {
        "id": "S05_A029",
        "phrase": "update prefix ..."
      },
      {
        "id": "S05_A030",
        "phrase": "look back ..."
      },
      {
        "id": "S05_A031",
        "phrase": "count ..."
      },
      {
        "id": "S05_A032",
        "phrase": "then store."
      },
      {
        "id": "S05_A033",
        "phrase": "Now let us execute it on the full array."
