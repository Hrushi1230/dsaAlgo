        "phrase": "increase the frequency of the current prefix."
      },
      {
        "id": "S07_A014",
        "phrase": "Then continue to the next value."
      },
      {
        "id": "S07_A015",
        "phrase": "Finally … return the answer."
      },
      {
        "id": "S07_A016",
        "phrase": "Notice the order again."
      },
      {
        "id": "S07_A017",
        "phrase": "Update prefix …"
      },
      {
        "id": "S07_A018",
        "phrase": "compute needed …"
      },
      {
        "id": "S07_A019",
        "phrase": "query earlier prefixes …"
      },
      {
        "id": "S07_A020",
        "phrase": "add matches …"
      },
      {
        "id": "S07_A021",
        "phrase": "then store current prefix."
      },
      {
