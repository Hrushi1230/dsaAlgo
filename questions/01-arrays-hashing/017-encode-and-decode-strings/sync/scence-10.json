  "sentences": [
    {
      "text": "Quick recap.",
      "start_ms": 0,
      "end_ms": 900,
      "start_frame": 0,
      "end_frame": 27,
      "word_count": 2
    },
    {
      "text": "Our format is length hash payload.",
      "start_ms": 1780,
      "end_ms": 5000,
      "start_frame": 53,
      "end_frame": 150,
      "word_count": 6
    },
    {
      "text": "The decoder reads the length, then consumes exactly that many characters.",
      "start_ms": 5800,
      "end_ms": 10460,
      "start_frame": 174,
      "end_frame": 314,
      "word_count": 11
    },
    {
      "text": "The reusable idea is simple.",
      "start_ms": 11440,
      "end_ms": 13460,
      "start_frame": 343,
      "end_frame": 404,
      "word_count": 5
    },
    {
      "text": "When the payload can contain separate our characters, store explicit boundary information.",
      "start_ms": 13800,
      "end_ms": 19900,
      "start_frame": 414,
      "end_frame": 597,
      "word_count": 12
    },
    {
      "text": "Question 17.",
      "start_ms": 21100,
      "end_ms": 22060,
      "start_frame": 633,
      "end_frame": 662,
      "word_count": 2
    },
    {
      "text": "Encode and decode strings.",
      "start_ms": 22780,
      "end_ms": 24640,
      "start_frame": 683,
      "end_frame": 739,
      "word_count": 4
    },
    {
      "text": "Complete.",
      "start_ms": 25240,
      "end_ms": 25860,
      "start_frame": 757,
      "end_frame": 776,
      "word_count": 1
    },
    {
      "text": "Our progress is now.",
      "start_ms": 26420,
      "end_ms": 28080,
      "start_frame": 793,
      "end_frame": 842,
      "word_count": 4
    },
    {
      "text": "17 out of 227.",
      "start_ms": 28080,
      "end_ms": 32420,
      "start_frame": 842,
      "end_frame": 973,
      "word_count": 4
    },
    {
      "text": "Next, question 18.",
