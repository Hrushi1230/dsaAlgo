  ],
  "sentences": [
    {
      "text": "Start with an empty result list and set i to 0.",
      "start_ms": 0,
      "end_ms": 4080,
      "start_frame": 0,
      "end_frame": 122,
      "word_count": 11
    },
    {
      "text": "While i is inside the encoded string, set j to i.",
      "start_ms": 4900,
      "end_ms": 9040,
      "start_frame": 147,
      "end_frame": 271,
      "word_count": 11
    },
    {
      "text": "Move j until the next header hash.",
      "start_ms": 9440,
      "end_ms": 11760,
      "start_frame": 283,
      "end_frame": 353,
      "word_count": 7
    },
    {
      "text": "Convert the digits from i to j into the length.",
      "start_ms": 12220,
      "end_ms": 14740,
      "start_frame": 367,
      "end_frame": 442,
      "word_count": 10
    },
    {
      "text": "Now start is j plus 1, end is start plus length.",
      "start_ms": 15300,
      "end_ms": 19160,
      "start_frame": 459,
      "end_frame": 575,
      "word_count": 11
    },
    {
      "text": "Append that exact slice to the result, then set i to end.",
      "start_ms": 19840,
      "end_ms": 24160,
      "start_frame": 595,
      "end_frame": 725,
      "word_count": 12
    },
    {
      "text": "This takes us to the next record.",
      "start_ms": 25320,
      "end_ms": 27260,
      "start_frame": 760,
      "end_frame": 818,
      "word_count": 7
    },
    {
      "text": "Repeat until the string is finished.",
      "start_ms": 27940,
      "end_ms": 30580,
      "start_frame": 838,
      "end_frame": 917,
      "word_count": 6
    },
    {
      "text": "Finally, return the result.",
      "start_ms": 31660,
      "end_ms": 34200,
      "start_frame": 950,
      "end_frame": 1026,
      "word_count": 4
    },
    {
      "text": "That's the complete decoder.",
      "start_ms": 34840,
      "end_ms": 36700,
      "start_frame": 1045,
      "end_frame": 1101,
      "word_count": 4
    }
  ],
