  "sentences": [
    {
      "text": "Why does this work?",
      "start_ms": 0,
      "end_ms": 1200,
      "start_frame": 0,
      "end_frame": 36,
      "word_count": 4
    },
    {
      "text": "Because the payload does not decide its own boundary.",
      "start_ms": 1540,
      "end_ms": 4640,
      "start_frame": 46,
      "end_frame": 139,
      "word_count": 9
    },
    {
      "text": "The stored length does.",
      "start_ms": 5120,
      "end_ms": 6480,
      "start_frame": 154,
      "end_frame": 194,
      "word_count": 4
    },
    {
      "text": "Now, complexity.",
      "start_ms": 6920,
      "end_ms": 8240,
      "start_frame": 208,
      "end_frame": 247,
      "word_count": 2
    },
    {
      "text": "Let C be the total number of payload characters and N be the number of strings.",
      "start_ms": 9040,
      "end_ms": 14920,
      "start_frame": 271,
      "end_frame": 448,
      "word_count": 16
    },
    {
      "text": "Encoding processes every string and copies its characters.",
      "start_ms": 15800,
      "end_ms": 19580,
      "start_frame": 474,
      "end_frame": 587,
      "word_count": 8
    },
    {
      "text": "Time complexity.",
      "start_ms": 20420,
      "end_ms": 21700,
      "start_frame": 613,
      "end_frame": 651,
      "word_count": 2
    },
    {
      "text": "O of C plus N.",
      "start_ms": 22340,
      "end_ms": 24620,
      "start_frame": 670,
      "end_frame": 739,
      "word_count": 5
    },
    {
      "text": "Decoding reads the headers and payloads in one forward pass.",
      "start_ms": 25040,
      "end_ms": 29260,
      "start_frame": 751,
      "end_frame": 878,
      "word_count": 10
    },
    {
      "text": "Again, O of C plus N.",
      "start_ms": 30020,
      "end_ms": 32940,
      "start_frame": 901,
      "end_frame": 988,
      "word_count": 6
    },
    {
      "text": "The constructed output also needs O of C plus N space.",
      "start_ms": 33420,
      "end_ms": 38420,
      "start_frame": 1003,
      "end_frame": 1153,
      "word_count": 11
    }
  ],
