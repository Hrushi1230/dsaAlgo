  "sentences": [
    {
      "text": "The code is short.",
      "start_ms": 0,
      "end_ms": 1300,
      "start_frame": 0,
      "end_frame": 39,
      "word_count": 4
    },
    {
      "text": "Create an empty list called parts.",
      "start_ms": 2000,
      "end_ms": 4180,
      "start_frame": 60,
      "end_frame": 125,
      "word_count": 6
    },
    {
      "text": "For every input string, append its length as text.",
      "start_ms": 4940,
      "end_ms": 8840,
      "start_frame": 148,
      "end_frame": 265,
      "word_count": 9
    },
    {
      "text": "Append the hash.",
      "start_ms": 9500,
      "end_ms": 10380,
      "start_frame": 285,
      "end_frame": 311,
      "word_count": 3
    },
    {
      "text": "Then append the string itself.",
      "start_ms": 10820,
      "end_ms": 12500,
      "start_frame": 325,
      "end_frame": 375,
      "word_count": 5
    },
    {
      "text": "After the loop, join all the parts into one string.",
      "start_ms": 13360,
      "end_ms": 17180,
      "start_frame": 401,
      "end_frame": 515,
      "word_count": 10
    },
    {
      "text": "And return it.",
      "start_ms": 17840,
      "end_ms": 18860,
      "start_frame": 535,
      "end_frame": 566,
      "word_count": 3
    },
    {
      "text": "That's the encoder.",
      "start_ms": 19620,
      "end_ms": 20740,
      "start_frame": 589,
      "end_frame": 622,
      "word_count": 3
    },
    {
      "text": "Now let's decode the string we created.",
      "start_ms": 21280,
      "end_ms": 23360,
      "start_frame": 638,
      "end_frame": 701,
      "word_count": 7
    }
  ],
