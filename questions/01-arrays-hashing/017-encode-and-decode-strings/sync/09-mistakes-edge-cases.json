  "sentences": [
    {
      "text": "Three quick things to remember.",
      "start_ms": 0,
      "end_ms": 1940,
      "start_frame": 0,
      "end_frame": 58,
      "word_count": 5
    },
    {
      "text": "Do not split the encoded string on every hash.",
      "start_ms": 2600,
      "end_ms": 5580,
      "start_frame": 78,
      "end_frame": 167,
      "word_count": 9
    },
    {
      "text": "The length can have multiple digits, and after decoding each payload, always move i to end.",
      "start_ms": 6340,
      "end_ms": 12980,
      "start_frame": 190,
      "end_frame": 389,
      "word_count": 16
    },
    {
      "text": "For edge cases, an empty list encodes to an empty string.",
      "start_ms": 13640,
      "end_ms": 17800,
      "start_frame": 409,
      "end_frame": 534,
      "word_count": 11
    },
    {
      "text": "One empty string encodes to 0 hash and a string containing only a hash encodes to 1 hash hash.",
      "start_ms": 18540,
      "end_ms": 28420,
      "start_frame": 556,
      "end_frame": 853,
      "word_count": 19
    },
    {
      "text": "The same protocol handles all of them.",
      "start_ms": 28420,
      "end_ms": 31700,
      "start_frame": 853,
      "end_frame": 951,
      "word_count": 7
    }
  ],
